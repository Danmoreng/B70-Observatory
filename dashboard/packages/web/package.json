{
  "name": "@observatory/web",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 dashboard for the Local AI B70 Observatory",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @observatory/contracts",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@observatory/contracts": "*",
    "dompurify": "^3.4.15",
    "echarts": "6.1.0",
    "markdown-it": "^15.0.2",
    "vue": "^3.5.13",
    "vue-echarts": "8.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
