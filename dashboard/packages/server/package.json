{
  "name": "@observatory/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify backend API for the Local AI B70 Observatory (health endpoint in M1)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@observatory/contracts": "*",
    "@observatory/runner": "*",
    "fastify": "^5.2.0",
    "sharp": "^0.34.5",
    "undici": "7.30.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
