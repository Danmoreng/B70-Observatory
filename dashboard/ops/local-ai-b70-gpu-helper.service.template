[Unit]
Description=Local AI B70 privileged GPU telemetry helper
Before=local-ai-b70-observatory.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group={{GROUP}}
WorkingDirectory=/
Environment=OBSERVATORY_GPU_HELPER_SOCKET=/run/local-ai-b70-observatory/gpu.sock
ExecStart={{HELPER_BINARY}}
Restart=on-failure
RestartSec=3s
RuntimeDirectory=local-ai-b70-observatory
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
